{% comment %}
  Section: Gift Guide Banner
  ===========================
  A full-width banner section consisting of three visual parts:
  1. Top bar — brand name, promotional message, and yellow CTA button
  2. Hero area — illustrated background image with heading, description, and
     black "SHOP NOW" button (text sits bottom-left on desktop, above image on mobile)
  3. Bottom strip — sustainability / tagline text on a light gray bar

  All visible text is editable from the Shopify theme customizer.
  Buttons include hover animations (arrow slide effect).
  No jQuery — vanilla CSS animations only.
{% endcomment %}

<section
  class="gift-banner"
  data-section-id="{{ section.id }}"
  data-section-type="gift-guide-banner"
>
  {%- comment -%} === TOP BAR === {%- endcomment -%}
  <div class="gift-banner__topbar">
    <div class="gift-banner__topbar-inner">
      {%- comment -%} Brand name — editable from customizer {%- endcomment -%}
      <span class="gift-banner__brand">{{ section.settings.brand_name }}</span>

      {%- comment -%} Promo message — editable from customizer {%- endcomment -%}
      <p class="gift-banner__message">{{ section.settings.promo_message }}</p>

      {%- comment -%} CTA button with arrow slide animation on hover {%- endcomment -%}
      <a
        href="{{ section.settings.cta_link }}"
        class="gift-banner__cta-btn"
        {% if section.settings.cta_link == blank %}role="button" aria-disabled="true"{% endif %}
      >
        <span class="gift-banner__cta-label">{{ section.settings.cta_label }}</span>
        <span class="gift-banner__cta-arrow">
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1L17 6M17 6L12 11M17 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>

  {%- comment -%} === HERO AREA === {%- endcomment -%}
  <div class="gift-banner__hero">
    {%- comment -%}
      Mobile-only: heading + description appear ABOVE the image.
      These elements are duplicated and shown/hidden via CSS
      to match the Figma mobile layout without JavaScript.
    {%- endcomment -%}
    <div class="gift-banner__mobile-text">
      {%- if section.settings.heading != blank -%}
        <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="gift-banner__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} Background image — uploadable from customizer {%- endcomment -%}
    <div class="gift-banner__hero-media">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 3840
          | image_tag:
            widths: '600, 900, 1200, 1600, 1920, 2560, 3840',
            class: 'gift-banner__hero-img',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.heading
        }}
      {%- else -%}
        {%- comment -%} Placeholder SVG when no image is set {%- endcomment -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-banner__hero-img gift-banner__hero-placeholder' }}
      {%- endif -%}

      {%- comment -%}
        Mobile-only: SHOP NOW button overlaid on the image (centered bottom).
        Hidden on desktop via CSS.
      {%- endcomment -%}
      {%- if section.settings.shop_label != blank -%}
        <a
          href="{{ section.settings.shop_link }}"
          class="gift-banner__shop-btn gift-banner__shop-btn--mobile"
          {% if section.settings.shop_link == blank %}role="button" aria-disabled="true"{% endif %}
        >
          <span class="gift-banner__shop-label">{{ section.settings.shop_label }}</span>
          <span class="gift-banner__shop-arrow">
            <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M14 1L19 6M19 6L14 11M19 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%}
      Desktop-only: heading + description + SHOP NOW button
      positioned bottom-left over the background image.
    {%- endcomment -%}
    <div class="gift-banner__hero-content">
      {%- if section.settings.heading != blank -%}
        <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="gift-banner__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- comment -%} Shop button with arrow slide animation {%- endcomment -%}
      {%- if section.settings.shop_label != blank -%}
        <a
          href="{{ section.settings.shop_link }}"
          class="gift-banner__shop-btn gift-banner__shop-btn--desktop"
          {% if section.settings.shop_link == blank %}role="button" aria-disabled="true"{% endif %}
        >
          <span class="gift-banner__shop-label">{{ section.settings.shop_label }}</span>
          <span class="gift-banner__shop-arrow">
            <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M14 1L19 6M19 6L14 11M19 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} === SUSTAINABILITY STRIP === {%- endcomment -%}
  {%- if section.settings.strip_text != blank -%}
    <div class="gift-banner__strip">
      <p class="gift-banner__strip-text">{{ section.settings.strip_text }}</p>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* ============================================================
     GIFT GUIDE BANNER — Styles
     Built from scratch, no Dawn dependencies.
     Pixel-perfect match to Figma design.
     ============================================================ */

  .gift-banner {
    width: 100%;
    background-color: #f5f5f5;
  }

  /* ------- TOP BAR ------- */
  .gift-banner__topbar {
    background-color: #fff;
    padding: 14px 0;
  }

  .gift-banner__topbar-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .gift-banner__brand {
    font-family: inherit;
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #000;
  }

  .gift-banner__message {
    margin: 0;
    font-size: 0.8125rem;
    color: #333;
    text-align: center;
    flex: 1;
  }

  /* CTA Button — yellow (#E8E231) with arrow slide animation */
  .gift-banner__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 24px;
    background-color: #E8E231;
    color: #000;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.3s ease;
  }

  .gift-banner__cta-arrow {
    display: inline-flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .gift-banner__cta-arrow svg {
    width: 18px;
    height: 12px;
  }

  /* Arrow slides right on hover */
  .gift-banner__cta-btn:hover .gift-banner__cta-arrow {
    transform: translateX(5px);
  }

  .gift-banner__cta-btn:hover {
    background-color: #d4cc2b;
  }

  /* ------- HERO AREA ------- */
  .gift-banner__hero {
    position: relative;
  }

  /* Mobile text block: hidden on desktop */
  .gift-banner__mobile-text {
    display: none;
  }

  .gift-banner__hero-media {
    position: relative;
    width: 100%;
    min-height: 560px;
  }

  .gift-banner__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    position: absolute;
    inset: 0;
  }

  .gift-banner__hero-placeholder {
    background-color: #f0f0f0;
  }

  /* Desktop: text content overlaid bottom-left on the image */
  .gift-banner__hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    max-width: 1400px;
    padding: 60px 40px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .gift-banner__heading {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
    color: #000;
  }

  .gift-banner__description {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: #333;
    max-width: 360px;
  }

  .gift-banner__description p {
    margin: 0;
  }

  /* Shop Button — black with arrow slide animation */
  .gift-banner__shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 14px 28px;
    background-color: #000;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    width: fit-content;
    transition: background-color 0.3s ease;
  }

  .gift-banner__shop-arrow {
    display: inline-flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .gift-banner__shop-arrow svg {
    width: 20px;
    height: 12px;
  }

  /* Arrow slides right on hover */
  .gift-banner__shop-btn:hover .gift-banner__shop-arrow {
    transform: translateX(5px);
  }

  .gift-banner__shop-btn:hover {
    background-color: #222;
  }

  /* Mobile shop button: hidden on desktop */
  .gift-banner__shop-btn--mobile {
    display: none;
  }

  /* ------- SUSTAINABILITY STRIP ------- */
  .gift-banner__strip {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
    padding: 12px 20px;
    text-align: center;
  }

  .gift-banner__strip-text {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000;
  }

  /* ===========================================================
     MOBILE RESPONSIVE (<750px)
     On mobile, the Figma shows:
     - No top bar (header handles branding)
     - Heading + description appear ABOVE the illustration image
     - "SHOP NOW" button centered at bottom of the image
     - Sustainability strip below
     =========================================================== */
  @media screen and (max-width: 749px) {
    /* Hide the top bar on mobile (the store header handles it) */
    .gift-banner__topbar {
      display: none;
    }

    /* Show mobile text block above image */
    .gift-banner__mobile-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 32px 24px 20px;
      gap: 10px;
      background-color: #fff;
    }

    .gift-banner__mobile-text .gift-banner__heading {
      font-size: 1.75rem;
    }

    .gift-banner__mobile-text .gift-banner__description {
      max-width: 320px;
      font-size: 0.8125rem;
    }

    /* Reduce hero image height on mobile */
    .gift-banner__hero-media {
      min-height: 320px;
    }

    /* Show mobile shop button centered over bottom of image */
    .gift-banner__shop-btn--mobile {
      display: inline-flex;
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
      padding: 14px 32px;
    }

    /* Hide desktop hero content on mobile */
    .gift-banner__hero-content {
      display: none;
    }

    .gift-banner__strip-text {
      font-size: 0.5625rem;
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "div",
  "class": "gift-guide-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Top Bar"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "promo_message",
      "label": "Promotional message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Hero Area"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description text",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop button link"
    },
    {
      "type": "header",
      "content": "Bottom Strip"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Strip text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
