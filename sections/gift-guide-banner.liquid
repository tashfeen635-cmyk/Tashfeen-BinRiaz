{% comment %}
  Section: Gift Guide Banner
  ===========================
  Desktop: CSS background-image covers the full section.
           Top bar + text content overlay on the illustration.
  Mobile:  Heading + description on white above the illustration.
           Illustration shown as a contained image block.
           SHOP NOW button overlaid centered on the illustration.
{% endcomment %}

{%- comment -%} Resolve the background image URL {%- endcomment -%}
{%- if section.settings.hero_image != blank -%}
  {%- assign hero_img = section.settings.hero_image -%}
  {%- assign hero_bg_url = hero_img | image_url: width: 3840 -%}
{%- else -%}
  {%- assign hero_bg_url = 'example.png' | asset_url -%}
{%- endif -%}

{%- comment -%} Resolve the mobile hero image URL {%- endcomment -%}
{%- if section.settings.mobile_hero_image != blank -%}
  {%- assign mobile_hero_url = section.settings.mobile_hero_image | image_url: width: 1200 -%}
{%- else -%}
  {%- assign mobile_hero_url = 'mobile-hero.png' | asset_url -%}
{%- endif -%}

<section
  class="gift-banner"
  data-section-id="{{ section.id }}"
  data-section-type="gift-guide-banner"
  style="--desktop-hero-bg: url('{{ hero_bg_url }}'); --mobile-hero-bg: url('{{ mobile_hero_url }}');"
>
  {%- comment -%} === TOP BAR === {%- endcomment -%}
  <div class="gift-banner__topbar" id="gift-topbar">
    <div class="gift-banner__topbar-inner">
      {%- comment -%} Hamburger: visible on mobile closed state {%- endcomment -%}
      <button class="gift-banner__hamburger" id="gift-hamburger" aria-label="Open menu">
        <svg width="24" height="16" viewBox="0 0 24 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <line x1="0" y1="1" x2="24" y2="1" stroke="#000" stroke-width="2"/>
          <line x1="0" y1="8" x2="24" y2="8" stroke="#000" stroke-width="2"/>
          <line x1="0" y1="15" x2="24" y2="15" stroke="#000" stroke-width="2"/>
        </svg>
      </button>
      {%- comment -%} Close X: visible on mobile open state {%- endcomment -%}
      <button class="gift-banner__close" id="gift-close" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M2 2L18 18M18 2L2 18" stroke="#000" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <span class="gift-banner__brand">{{ section.settings.brand_name }}</span>
      <p class="gift-banner__message">{{ section.settings.promo_message }}</p>
      <a
        href="{{ section.settings.cta_link }}"
        class="gift-banner__cta-btn"
        {% if section.settings.cta_link == blank %}role="button" aria-disabled="true"{% endif %}
      >
        <span class="gift-banner__cta-label">{{ section.settings.cta_label }}</span>
        <span class="gift-banner__cta-arrow">
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1L17 6M17 6L12 11M17 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
    {%- comment -%} Mobile drawer panel {%- endcomment -%}
    <div class="gift-banner__drawer" id="gift-drawer">
      <p class="gift-banner__drawer-message">{{ section.settings.promo_message }}</p>
      <a
        href="{{ section.settings.cta_link }}"
        class="gift-banner__cta-btn gift-banner__drawer-cta"
        {% if section.settings.cta_link == blank %}role="button" aria-disabled="true"{% endif %}
      >
        <span class="gift-banner__cta-label">{{ section.settings.cta_label }}</span>
        <span class="gift-banner__cta-arrow">
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1L17 6M17 6L12 11M17 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>

  <script>
    (function() {
      var hamburger = document.getElementById('gift-hamburger');
      var closeBtn = document.getElementById('gift-close');
      var topbar = document.getElementById('gift-topbar');
      if (hamburger && closeBtn && topbar) {
        hamburger.addEventListener('click', function() {
          topbar.classList.add('gift-banner__topbar--open');
        });
        closeBtn.addEventListener('click', function() {
          topbar.classList.remove('gift-banner__topbar--open');
        });
      }
    })();
  </script>

  {%- comment -%} === MOBILE: text above image (hidden on desktop) === {%- endcomment -%}
  <div class="gift-banner__mobile-text">
    {%- if section.settings.heading != blank -%}
      <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="gift-banner__description">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} === MOBILE: illustration image block with SHOP NOW overlay (hidden on desktop) === {%- endcomment -%}
  <div class="gift-banner__mobile-media">
    <img
      src="{{ mobile_hero_url }}"
      alt="{{ section.settings.heading }}"
      class="gift-banner__mobile-img"
      loading="eager"
      fetchpriority="high"
    />
    {%- if section.settings.shop_label != blank -%}
      <a
        href="{{ section.settings.shop_link }}"
        class="gift-banner__shop-btn gift-banner__shop-btn--mobile"
        {% if section.settings.shop_link == blank %}role="button" aria-disabled="true"{% endif %}
      >
        <span class="gift-banner__shop-label">{{ section.settings.shop_label }}</span>
        <span class="gift-banner__shop-arrow">
          <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M14 1L19 6M19 6L14 11M19 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    {%- endif -%}
  </div>

  {%- comment -%} === DESKTOP: hero content bottom-left (hidden on mobile) === {%- endcomment -%}
  <div class="gift-banner__hero">
    <div class="gift-banner__hero-content">
      {%- if section.settings.heading != blank -%}
        <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="gift-banner__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.shop_label != blank -%}
        <a
          href="{{ section.settings.shop_link }}"
          class="gift-banner__shop-btn"
          {% if section.settings.shop_link == blank %}role="button" aria-disabled="true"{% endif %}
        >
          <span class="gift-banner__shop-label">{{ section.settings.shop_label }}</span>
          <span class="gift-banner__shop-arrow">
            <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M14 1L19 6M19 6L14 11M19 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} === SUSTAINABILITY STRIP === {%- endcomment -%}
  {%- if section.settings.strip_text != blank -%}
    <div class="gift-banner__strip">
      <p class="gift-banner__strip-text">{{ section.settings.strip_text }}</p>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* ============================================================
     GIFT GUIDE BANNER
     Desktop: background-image covers full section
     Mobile:  text above, image as block, button overlaid
     ============================================================ */

  /* ------- MAIN WRAPPER ------- */
  .gift-banner {
    width: 100%;
    background-color: #f5f5f5;
    background-image: var(--desktop-hero-bg);
    background-size: contain;
    background-position: center center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
  }

  /* ------- TOP BAR (desktop only) ------- */
  .gift-banner__topbar {
    padding: 10px 0;
    background: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
  }

  .gift-banner__topbar-inner {
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  /* Hamburger & Close — hidden on desktop, shown on mobile */
  .gift-banner__hamburger {
    display: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: 0;
  }

  .gift-banner__close {
    display: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: 0;
  }

  /* Mobile drawer panel — hidden on desktop */
  .gift-banner__drawer {
    display: none;
  }

  .gift-banner__brand {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #000;
  }

  .gift-banner__message {
    margin: 0;
    font-family: 'Jost', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    color: #333;
    text-align: center;
    flex: 1;
  }

  .gift-banner__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 24px;
    background-color: #E8E231;
    color: #000;
    font-family: 'Jost', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.3s ease;
  }

  .gift-banner__cta-arrow {
    display: inline-flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .gift-banner__cta-arrow svg {
    width: 18px;
    height: 12px;
  }

  .gift-banner__cta-btn:hover .gift-banner__cta-arrow {
    transform: translateX(5px);
  }

  .gift-banner__cta-btn:hover {
    background-color: #d4cc2b;
  }

  /* ------- MOBILE ELEMENTS (hidden on desktop) ------- */
  .gift-banner__mobile-text {
    display: none;
  }

  .gift-banner__mobile-media {
    display: none;
  }

  /* ------- DESKTOP HERO AREA ------- */
  .gift-banner__hero {
    flex: 1;
    min-height: 52vw;
    display: flex;
    align-items: flex-end;
    box-sizing: content-box;
  }

  .gift-banner__hero-content {
    
    padding:70px 48px;
    display: flex;
    flex-direction: column;
    gap:50px ;
    background: transparent;
  }

  .gift-banner__heading {
    font-family: Jost;
    font-size: 70px;
    font-weight: 500;
    line-height: 1.1;
    margin: 0;
    color: #000;
    letter-spacing: 0px;

  }

  .gift-banner__description {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: #333;
    max-width: 400px;
  }

  .gift-banner__description p {
    
    font-family: jost;
    font-weight: 400;
    font-size: 17px;
  }

  /* ------- SHOP NOW BUTTON ------- */
  .gift-banner__shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 14px 50px;
    background-color: #000;
    color: #fff;
    font-size: .6875rem;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    width: fit-content;
    transition: background-color .3s ease;
  }

  .gift-banner__shop-arrow {
    display: inline-flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .gift-banner__shop-arrow svg {
    width: 20px;
    height: 12px;
  }

  .gift-banner__shop-btn:hover .gift-banner__shop-arrow {
    transform: translateX(5px);
  }

  .gift-banner__shop-btn:hover {
    background-color: #222;
  }

  /* Mobile button variant: hidden on desktop */
  .gift-banner__shop-btn--mobile {
    display: none;
  }

  /* ------- SUSTAINABILITY STRIP ------- */
  .gift-banner__strip {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
    padding: 12px 20px;
    text-align: center;
  }

  .gift-banner__strip-text {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000;
  }

  /* ===========================================================
     MOBILE (<768px)
     Same background image as desktop, content overlaid on top.
     Heading + description + SHOP NOW all centered on the image.
     No white backgrounds. No separate image block.
     =========================================================== */
  @media screen and (max-width: 768px) {

    /* Switch to mobile hero background image */
    .gift-banner {
      background-image: var(--mobile-hero-bg);
      background-size: cover;
      background-position: center center;
      background-color: #f5f5f5;
    }

    /* Mobile topbar — hamburger left, brand centered */
    .gift-banner__topbar {
      display: block;
      padding: 14px 0;
      background: #f5f5f5;
      border-bottom: 1px solid #e0e0e0;
    }

    .gift-banner__topbar-inner {
      display: grid;
      grid-template-columns: 48px 1fr 48px;
      align-items: center;
      padding: 0 16px;
      gap: 0;
    }

    /* Show hamburger, hide close by default */
    .gift-banner__hamburger {
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    .gift-banner__close {
      display: none;
      align-items: center;
      justify-content: flex-start;
    }

    .gift-banner__brand {
      text-align: center;
      font-family: 'Jost', sans-serif;
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: 0.08em;
    }

    /* Hide promo message and CTA in topbar-inner on mobile */
    .gift-banner__message {
      display: none;
    }

    .gift-banner__cta-btn {
      display: none;
    }

    /* --- OPEN STATE: swap hamburger → X, show drawer --- */
    .gift-banner__topbar--open .gift-banner__hamburger {
      display: none;
    }

    .gift-banner__topbar--open .gift-banner__close {
      display: flex;
    }

    .gift-banner__topbar--open .gift-banner__drawer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      padding: 24px 20px 28px;
      background: #f5f5f5;
      border-top: 1px solid #e0e0e0;
    }

    .gift-banner__drawer-message {
      margin: 0;
      font-family: 'Jost', sans-serif;
      font-size: 0.9375rem;
      font-weight: 400;
      color: #333;
      text-align: center;
    }

    .gift-banner__topbar--open .gift-banner__drawer-cta {
      display: inline-flex;
      padding: 14px 40px;
      font-family: 'Jost', sans-serif;
    }

    /* Hide separate mobile elements — not needed, using hero overlay */
    .gift-banner__mobile-text {
      display: none;
    }

    .gift-banner__mobile-media {
      display: none;
    }

    /* Show hero on mobile — reposition for centered layout */
    .gift-banner__hero {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      min-height: auto;
    }

    .gift-banner__hero-content {
      align-items: center;
      text-align: center;
      padding: 16px 24px 32px;
      gap: 14px;
      width: 100%;
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }

    /* Mobile heading */
    .gift-banner__heading {
      font-family: 'Jost', sans-serif;
      font-size: 1.75rem;
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.15;
      color: #000;
    }

    /* Mobile description */
    .gift-banner__description {
      max-width: 260px;
      margin: 0 auto;
    }

    .gift-banner__description p {
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: #333;
    }

    /* Mobile SHOP NOW button — centered */
    .gift-banner__shop-btn {
      align-self: center;
      padding: 14px 36px;
      gap: 16px;
      font-family: 'Jost', sans-serif;
      font-size: 0.6875rem;
      font-weight: 400;
      letter-spacing: 0.1em;
    }

    /* Strip */
    .gift-banner__strip {
      background-color: #f5f5f5;
    }

    .gift-banner__strip-text {
      font-family: 'Jost', sans-serif;
      font-size: 0.5625rem;
      letter-spacing: 0.12em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "div",
  "class": "gift-guide-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Top Bar"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "promo_message",
      "label": "Promotional message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Hero Area"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop background image (overrides default)"
    },
    {
      "type": "image_picker",
      "id": "mobile_hero_image",
      "label": "Mobile hero image (overrides default)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description text",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop button link"
    },
    {
      "type": "header",
      "content": "Bottom Strip"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Strip text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
